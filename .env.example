# Copy to .env.local and fill in. Never put real values in this file:
# it is committed, .env.local is not.

# Cal.com booking link, the path after cal.com/
NEXT_PUBLIC_CALCOM_LINK=

# WhatsApp number in international format, no plus sign
NEXT_PUBLIC_WHATSAPP_NUMBER=254785629612

# Sanity, from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics 4 measurement id
NEXT_PUBLIC_GA_ID=

# Mailchimp newsletter
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Shared newsletter rate limiting (recommended for multiple server instances).
# Obtain the REST URL and token from an Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set true only behind a proxy that overwrites X-Forwarded-For and blocks
# direct access to the origin. Vercel is recognized automatically.
TRUST_PROXY=false

# Optional browser-check overrides (Chrome/Edge is detected on this Windows PC).
# BROWSER_EXECUTABLE_PATH=
# BASE_URL=http://localhost:3000
