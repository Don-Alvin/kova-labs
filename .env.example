# Copy to .env.local and fill in. Never put real values in this file:
# it is committed, .env.local is not.

# Cal.com booking link, the path after cal.com/
NEXT_PUBLIC_CALCOM_LINK=your-username/your-event

# WhatsApp number in international format, no plus sign
NEXT_PUBLIC_WHATSAPP_NUMBER=2547XXXXXXXX

# Sanity, from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token

# Google Analytics 4 measurement id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Mailchimp newsletter
MAILCHIMP_API_KEY=your-api-key
MAILCHIMP_AUDIENCE_ID=your-audience-id
MAILCHIMP_SERVER_PREFIX=usX
